# Meridian — environment variables
# Copy to .env for local development. NEVER commit real values.

# ---------------------------------------------------------------------------
# CryptoRank (optional additive context: rank, market cap, supply, unlocks)
# Dashboard: https://cryptorank.io/public-api/dashboard
# After setting on Vercel → Redeploy, then verify:
#   GET /api/health          → cryptorank.configured = true
#   GET /api/cryptorank/plan → plan tier / credits
#   GET /api/screen?limit=5  → each row has non-null "cryptorank" block
# ---------------------------------------------------------------------------
CRYPTORANK_API_KEY=

# CryptoRank response cache TTL in seconds (credits are quota-limited).
CR_CACHE_SECONDS=300

# Unlock-gate thresholds (% of market cap unlocking within 30d). Pro plan only.
# LONG → WATCH at >= WATCH_PCT; LONG/WATCH → AVOID at >= AVOID_PCT.
CR_UNLOCK_WATCH_PCT=1.0
CR_UNLOCK_AVOID_PCT=3.0

# Live | auto | seed — forced source selection for the market data chain.
SCREEN_SOURCE=auto

# Screen response cache TTL in seconds (serverless in-process).
SCREEN_CACHE_SECONDS=60

# How many volume-qualified pairs to probe for daily history per request.
# The ">=61 daily candles" criterion is checked BEFORE the top-N slice, so a
# young coin can never occupy a display slot while a scorable coin further down
# the volume ranking goes unfetched. Probe count = clamp(limit x multiplier, limit, cap).
KLINE_CANDIDATE_MULTIPLIER=3
KLINE_CANDIDATE_CAP=60

# Binance chain order.
#
# Updated 2026-11: this project now deploys functions to Singapore (sin1) via
# the "regions" key in vercel.json, because Binance geo-blocks US regions with
# HTTP 451. From sin1 the vision mirror (data-api.binance.vision) answers with
# real market data, so BINANCE_US_FIRST is no longer needed — and Binance.US
# only lists a subset of symbols anyway (short/absent history for many pairs).
# Keep it empty unless you deliberately move back to a US region.
#
# Diagnostics: after deploy, expand "Kenapa live gagal?" in the app banner to
# see the exact per-host failure reasons (HTTP code / DNS / timeout).
BINANCE_US_FIRST=
