# Meridian — environment variables
# Copy to .env for local development. NEVER commit real values.

# Optional: CryptoRank Public API key (https://cryptorank.io/public-api/dashboard).
# Used only as an additive context layer (rank / market cap / supply). The
# screener works fine without it. On Vercel, set this as an encrypted env var.
CRYPTORANK_API_KEY=

# CryptoRank response cache TTL in seconds (credits are quota-limited).
CR_CACHE_SECONDS=300

# Live | auto | seed — forced source selection for the market data chain.
SCREEN_SOURCE=auto

# Screen response cache TTL in seconds (serverless in-process).
SCREEN_CACHE_SECONDS=60

# Binance chain order. Vercel functions run in iad1 (US) by default; Binance
# geo-blocks many US datacenter IPs, while api.binance.us is the US-legal
# endpoint. Set BINANCE_US_FIRST=1 to try Binance.US before the vision mirror
# (universe AND klines). Diagnostics: after deploy, expand "Kenapa live gagal?"
# in the app banner to see the exact per-host failure reasons.
BINANCE_US_FIRST=
